# =====================================================================
# Arisca Light Studio — Frontend Environment Configuration
# =====================================================================
# CURRENT: GitHub Pages Live Link (default)
VITE_SITE_URL=https://bluenovatechin.github.io/Arisca-Light-Studio

# =====================================================================
# FUTURE DOMAIN SWITCH GUIDE:
# When you purchase a custom domain (e.g., https://www.yourdomain.com):
# 1. Update VITE_SITE_URL to your new domain:
#    VITE_SITE_URL=https://www.yourdomain.com
# 2. Put your domain name in public/CNAME (e.g. yourdomain.com)
# 3. In GitHub repository Settings -> Pages -> Custom domain, enter your domain
# 4. Build with: BASE_PATH=/ npm run build (or put BASE_PATH=/ in .env)
# Everything (Open Graph, WhatsApp previews, Google Search, Google Lens,
# Schema.org, sitemaps, AI catalog, and canonicals) will instantly switch!
# =====================================================================

# Studio Customer Care WhatsApp Direct Line (without + or spaces)
VITE_WHATSAPP_NUMBER=919898086656

# Optional: Google Analytics 4 (GA4) Measurement ID (e.g. G-ABC123XYZ)
VITE_GA_MEASUREMENT_ID=
