# Arisca Light Studio — Frontend Environment Configuration
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put private server secrets, private database credentials, or secret keys here!

# Production Site Canonical URL
VITE_SITE_URL=https://www.ariscalightstudio.com

# Studio Customer Care WhatsApp Direct Line (without + or spaces)
VITE_WHATSAPP_NUMBER=919898086656

# Optional: Google Analytics 4 (GA4) Measurement ID (e.g. G-ABC123XYZ)
# Leave blank to run in offline / privacy-only mode
VITE_GA_MEASUREMENT_ID=
